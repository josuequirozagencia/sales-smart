# ============================================
# ChatIA 4.7.9 - gitignore raíz
# ============================================

# Dependencias
node_modules/
.pnp
.pnp.js

# Artefactos de build
dist/
build/
*.tsbuildinfo

# Secretos y configuración local
# (los .env.example / .env.exemple SÍ se versionan: son plantillas)
.env
.env.local
.env.*.local
.env.original
.credentials
*.pem
*.key
!frontend/src/**/*.key

# Sesiones de WhatsApp (Baileys) y datos de runtime
backend/public/*
!backend/public/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
backend/private/*
!backend/private/.gitkeep

# Backups y dumps
backups/
*.sql
*.sql.gz
*.tar.gz
*.bak

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cobertura de tests
coverage/
coverage.data

# Python (api_transcricao)
__pycache__/
*.py[cod]
.venv/
venv/

# Sistema operativo / editores
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json.example
*.swp
.~*

# Proyecto aparte, con su propio repositorio.
/capa-comercial/
